# Snake VS - Apache / LiteSpeed (shared hosting). Ignored by other servers.
# Serves the precompressed .br/.gz files made by "dotnet publish" and sets the right types and caching.

Options -Indexes

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType text/javascript .js
    AddType application/json .json
    AddType application/octet-stream .dat .blat .dll .webcil
    # file.js.br keeps the type of .js and gets "Content-Encoding: br".
    AddEncoding br .br
    AddEncoding gzip .gz
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+)$ $1.br [L]
    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.+)$ $1.gz [L]
</IfModule>

# Already compressed: never compress again.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(br|gz)$" no-gzip no-brotli
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(br|gz)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
    # Fingerprinted files (name.0123456789.ext) never change: cache for a year.
    # Everything else (index.html, icons) is revalidated, so a new deploy shows up right away.
    Header set Cache-Control "no-cache"
    <FilesMatch "\.[a-z0-9]{10}\.(js|wasm|dat|css)(\.br|\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

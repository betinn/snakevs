<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Web site host: serves the game (SnakeVs.Web, Blazor WebAssembly) and the online ranking API (SQLite).
    "dotnet publish -c Release" produces one deployable folder (Kestrel, IIS, Azure App Service, Docker...).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SnakeVs.Server</RootNamespace>
    <AssemblyName>SnakeVs.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnakeVs.Core\SnakeVs.Core.csproj" />
    <ProjectReference Include="..\SnakeVs.Web\SnakeVs.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnakeVs.Server.Tests" />
  </ItemGroup>

</Project>

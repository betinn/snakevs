<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop (Windows/Linux/macOS) build. Used for development, automated screen captures and store art. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>SnakeVs.Desktop</RootNamespace>
    <AssemblyName>SnakeVs</AssemblyName>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnakeVs.Core\SnakeVs.Core.csproj" />
  </ItemGroup>

  <!-- Shared game code (rendering, scenes, input) is compiled into every platform head. -->
  <ItemGroup>
    <Compile Include="..\SnakeVs.Game\**\*.cs" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
